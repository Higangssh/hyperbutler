#!/bin/sh
# winbox guest prototype init (PID 1). Throwaway: see docs/adr/0005-guest-image.md.
#
# Mounts the API file systems, loads the modules for whichever hypervisor it finds
# (Hyper-V vmbus or virtio), brings up the network, mounts the data disk on
# /var/lib/docker (formatting it if it is blank), starts winboxd, and starts dockerd,
# which starts its own containerd. Every step prints "winbox-t <uptime> <step>" on the
# console so the host can see where boot time goes.
#
# Shutdown: SIGTERM or SIGUSR2 (what busybox poweroff sends, which is what the kernel
# runs when the host asks through the Hyper-V shutdown integration component) stops
# dockerd, which stops the containers; then the data disk is unmounted and the VM
# powers off.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

/bin/busybox --install -s

t() { read -r up _ </proc/uptime; echo "winbox-t $up $*"; }

mount -t proc -o nosuid,nodev,noexec proc /proc
t init-start
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts -o nosuid,noexec,gid=5,mode=0620,ptmxmode=0666 devpts /dev/pts
mount -t tmpfs -o nosuid,nodev,mode=1777 shm /dev/shm
mount -t tmpfs -o nosuid,nodev,mode=0755 run /run
mount -t tmpfs -o nosuid,nodev,mode=1777 tmp /tmp
mount -t cgroup2 -o nsdelegate cgroup2 /sys/fs/cgroup
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
ln -sf /proc/mounts /etc/mtab
hostname winbox
t mounts-done

# Hypervisor-specific drivers. hv_netvsc is built in; everything else is a module.
if [ -d /sys/bus/vmbus ]; then
	t hyperv
	modprobe -a hv_storvsc sd_mod hv_sock hv_balloon hv_utils
else
	t virtio
	modprobe -a virtio_rng virtio_net virtio_blk virtio_balloon vmw_vsock_virtio_transport
fi
modprobe -a overlay bridge br_netfilter veth
t modules-done

ip link set lo up
# Defaults are QEMU user networking (slirp). On Hyper-V, winbox passes the user-mode
# network of ADR 0006 on the command line: winbox.net=<host vsock port> starts netfwd,
# which creates eth0 as a TAP relayed to the host stack, and winbox.ip/gw/dns configure it.
ADDR=10.0.2.15/24
GW=10.0.2.2
DNS=10.0.2.3
LOGLEVEL=warn
NET=
MTU=1500
NETBENCH=
DATA=
NEWDISK=
MEMLOG=
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	winbox.ip=*) ADDR=${arg#winbox.ip=} ;;
	winbox.gw=*) GW=${arg#winbox.gw=} ;;
	winbox.dns=*) DNS=${arg#winbox.dns=} ;;
	winbox.loglevel=*) LOGLEVEL=${arg#winbox.loglevel=} ;;
	winbox.net=*) NET=${arg#winbox.net=} ;;
	winbox.mtu=*) MTU=${arg#winbox.mtu=} ;;
	winbox.netbench=1) NETBENCH="-bench-tcp 5201 -bench-vsock 5202" ;;
	winbox.data=*) DATA=${arg#winbox.data=} ;;
	winbox.newdisk=1) NEWDISK=1 ;;
	winbox.memlog=1) MEMLOG=1 ;;
	esac
done
if [ -n "$NET" ] && [ -d /sys/bus/vmbus ]; then
	modprobe tun
	# Restart netfwd if it dies. The TAP is persistent, so eth0 keeps its address.
	(while :; do
		# shellcheck disable=SC2086
		netfwd -port "$NET" -dev eth0 -mtu "$MTU" $NETBENCH >/dev/console 2>&1
		t "netfwd-exit $?"
		sleep 1
	done) &
	i=0
	while [ ! -e /sys/class/net/eth0 ] && [ $i -lt 250 ]; do
		sleep 0.02
		i=$((i + 1))
	done
	ip link set eth0 mtu "$MTU"
	# Containers on docker0 are routed, not NATed: the host stack sends replies for
	# them back to this guest address.
	echo 1 >/proc/sys/net/ipv4/ip_forward
	# Every frame netfwd writes to the TAP lands in the per-CPU input backlog; the
	# default of 1000 drops bursts from the host (one hvsock read carries hundreds of
	# frames) and turns host-to-guest TCP into retransmissions.
	echo 16384 >/proc/sys/net/core/netdev_max_backlog
fi
if ip link show eth0 >/dev/null 2>&1; then
	ip link set eth0 up
	ip addr add "$ADDR" dev eth0
	ip route add default via "$GW"
	echo "nameserver $DNS" >/etc/resolv.conf
fi
t net-done

# The data disk (winbox.data=sdX) holds /var/lib/docker: images, containers, volumes and
# their json-file logs. It is formatted only when it is blank (see data_disk), which is
# how a new VHDX reads; anything else that is not a clean ext4 is refused, never
# reformatted. Without winbox.data (the QEMU harness), /var/lib/docker is a tmpfs.
mkdir -p /var/lib/docker
data_disk() {
	dev=/dev/$DATA
	modprobe ext4
	i=0
	while [ ! -b "$dev" ] && [ $i -lt 500 ]; do
		sleep 0.01
		i=$((i + 1))
	done
	if [ ! -b "$dev" ]; then
		t "data-missing $dev"
		return 1
	fi
	# Blank means all three: the host says the VHDX was never written (winbox.newdisk=1:
	# its allocation is still what it was at creation), a complete read of the first MiB
	# succeeded and is all zero, and blkid finds no file system. A failed or short read
	# is never taken for a blank disk.
	blank=
	if [ -n "$NEWDISK" ] && dd if="$dev" of=/tmp/data-head bs=65536 count=16 2>/dev/null &&
		[ "$(wc -c </tmp/data-head)" -eq 1048576 ] &&
		[ "$(tr -d '\000' </tmp/data-head | wc -c)" -eq 0 ] &&
		[ -z "$(blkid "$dev" 2>/dev/null)" ]; then
		blank=1
	fi
	rm -f /tmp/data-head
	if [ -n "$blank" ]; then
		t data-mkfs
		# -J size=128: journal blocks, once written, stay allocated in the VHDX (they
		# are never free, so never trimmed). The default for 64 GiB is several times
		# larger.
		if ! mke2fs -q -F -t ext4 -m 0 -L winbox-data -J size=128 \
			-E nodiscard,lazy_itable_init=1,lazy_journal_init=1 "$dev" >/dev/console 2>&1; then
			t data-mkfs-failed
			return 1
		fi
	else
		# -p repairs what is safe to repair and fails (>= 4) on anything else.
		e2fsck -p "$dev" >/dev/console 2>&1
		rc=$?
		if [ $rc -ge 4 ]; then
			t "data-fsck-failed $rc"
			return 1
		fi
	fi
	# noinit_itable: the inode tables of a new VHDX already read as zeros, so the
	# background zeroing would only cost I/O.
	if ! mount -t ext4 -o noatime,noinit_itable "$dev" /var/lib/docker; then
		t data-mount-failed
		return 1
	fi
	t data-mounted
}
WINBOXD_ARGS=-no-trim
if [ -n "$DATA" ]; then
	if ! data_disk; then
		echo "winbox: the data disk could not be used; see the lines above" >/dev/console
		sleep 1
		poweroff -f
	fi
	WINBOXD_ARGS="-mount /var/lib/docker -dev /dev/$DATA -file /var/lib/docker/.winbox-reserve"
else
	mount -t tmpfs -o mode=0710 docker /var/lib/docker
fi

# winboxd: the host control channel (vsock 2380), the free-space guard, automatic
# fstrim and page-cache reclaim (docs/research/guest-services.md). The guard fails
# closed until the host's first budget arrives, so dockerd waits for that (bounded).
if [ -d /sys/bus/vmbus ]; then
	rm -f /run/winboxd.ready
	(while :; do
		# shellcheck disable=SC2086
		winboxd $WINBOXD_ARGS -ready /run/winboxd.ready >/dev/console 2>&1
		t "winboxd-exit $?"
		sleep 1
	done) &
	WINBOXD_LOOP=$!
	i=0
	while [ ! -e /run/winboxd.ready ] && [ $i -lt 1000 ]; do
		sleep 0.01
		i=$((i + 1))
	done
	t winboxd-ready
fi

# The root file system is the initramfs itself, where pivot_root(2) is impossible.
# DOCKER_RAMDISK makes runc fall back to MS_MOVE + chroot. The production image must
# not need this (see ADR 0005).
export DOCKER_RAMDISK=true
# dockerd listens on its Unix socket only. On Hyper-V the guest agent relays AF_VSOCK
# port 2375 (hvsock from the host, which HCS restricts to the user who created the VM)
# to it, and accepts connections from the host CID only.
#
# QEMU for Windows has no vsock device, so there sockfwd relays TCP from QEMU hostfwd
# instead. QEMU harness only: that relay has no authentication, so anything that can
# reach eth0:2375 (including containers) gets root-equivalent access to dockerd.
if [ -d /sys/bus/vmbus ]; then
	# Restart the agent if it dies; without it dockerd is unreachable.
	(while :; do
		agent -port 2375 -unix /run/docker.sock >/dev/console 2>&1
		t "agent-exit $?"
		sleep 1
	done) &
	AGENT_LOOP=$!
else
	sockfwd -listen "${ADDR%/*}:2375" -unix /run/docker.sock >/dev/console 2>&1 &
fi
DOCKERD=
stop_dockerd() {
	t shutdown-requested
	[ -n "$DOCKERD" ] && kill -TERM "$DOCKERD" 2>/dev/null
}
trap stop_dockerd TERM USR2 INT
t dockerd-exec
dockerd --host=unix:///run/docker.sock --iptables=false --ip6tables=false \
	--shutdown-timeout=10 --log-level="$LOGLEVEL" >/dev/console 2>&1 &
DOCKERD=$!

i=0
while [ ! -S /run/docker.sock ] && [ $i -lt 600 ]; do
	sleep 0.02
	i=$((i + 1))
done
t docker-sock

# winbox.memlog=1: guest-side memory every 15 s, so host numbers can be split into
# guest use and VMM cost.
if [ -n "$MEMLOG" ]; then
	(
		while sleep 15; do
			m=$(grep -E '^(MemTotal|MemFree|MemAvailable|Cached|Shmem):' /proc/meminfo | tr -s ' ' | tr '\n' ' ')
			t "mem $m"
		done
	) &
fi

# A trapped signal interrupts wait; keep waiting until dockerd is really gone.
while kill -0 "$DOCKERD" 2>/dev/null; do
	wait "$DOCKERD"
done
t dockerd-exit
for p in $WINBOXD_LOOP $AGENT_LOOP; do
	kill "$p" 2>/dev/null
done
killall winboxd agent 2>/dev/null
sync
if mountpoint -q /var/lib/docker; then
	umount /var/lib/docker 2>/dev/null || mount -o remount,ro /var/lib/docker
	t data-unmounted
fi
sync
poweroff -f
