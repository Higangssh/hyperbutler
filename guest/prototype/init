#!/bin/sh
# hyperbutler guest init (PID 1 after stage 1). See docs/adr/0005-guest-image.md.
#
# It runs from the read-only erofs system disk, which guest/prototype/initramfs-init
# mounted and switch_rooted into. Everything that must be writable is a mount: /run,
# /tmp and /dev/shm (tmpfs), /var/lib/docker (the data disk). /etc/resolv.conf is a
# link to /run/resolv.conf, and the BusyBox applet links are made at build time.
#
# Mounts the API file systems, loads the modules for whichever hypervisor it finds
# (Hyper-V vmbus or virtio), brings up the network, mounts the data disk on
# /var/lib/docker (formatting it if it is blank), starts hyperbutlerd, and starts dockerd,
# which starts its own containerd. Every step prints "hyperbutler-t <uptime> <step>" on the
# console so the host can see where boot time goes.
#
# Shutdown: SIGTERM or SIGUSR2 (what busybox poweroff sends, which is what the kernel
# runs when the host asks through the Hyper-V shutdown integration component) stops
# dockerd, which stops the containers; then the data disk is unmounted and the VM
# powers off.
#
# daemon.json (REQ-UX-007): the host sends the user's file over the control channel and
# hyperbutlerd installs it at /run/hyperbutler/daemon.json (the system disk is
# read-only). SIGHUP restarts dockerd with whatever is installed then; see
# guest/cmd/hyperbutlerd/daemoncfg.go for the rollback protocol (dockerd.gen, dockerd.hold).

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

t() { read -r up _ </proc/uptime; echo "hyperbutler-t $up $*"; }

mount -t proc -o nosuid,nodev,noexec proc /proc
t init-start
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts -o nosuid,noexec,gid=5,mode=0620,ptmxmode=0666 devpts /dev/pts
mount -t tmpfs -o nosuid,nodev,mode=1777 shm /dev/shm
mount -t tmpfs -o nosuid,nodev,mode=0755 run /run
mount -t tmpfs -o nosuid,nodev,mode=1777 tmp /tmp
mount -t cgroup2 -o nsdelegate cgroup2 /sys/fs/cgroup
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
hostname hyperbutler
t mounts-done

# Hypervisor-specific drivers. hv_netvsc is built in; everything else is a module.
if [ -d /sys/bus/vmbus ]; then
	t hyperv
	modprobe -a hv_storvsc sd_mod hv_sock hv_balloon hv_utils fuse
else
	t virtio
	modprobe -a virtio_rng virtio_net virtio_blk virtio_balloon vmw_vsock_virtio_transport
fi
modprobe -a overlay bridge br_netfilter veth
# For dockerd's embedded DNS rules (iptables-nft). The kernel would autoload them by alias,
# but the image ships no modules.alias.
modprobe -a nf_tables nft_compat nft_chain_nat nft_nat xt_nat xt_tcpudp
t modules-done

ip link set lo up
# Defaults are QEMU user networking (slirp). On Hyper-V, hyperbutler passes the user-mode
# network of ADR 0006 on the command line: hyperbutler.net=<host vsock port> starts netfwd,
# which creates eth0 as a TAP relayed to the host stack, and hyperbutler.ip/gw/dns configure it.
ADDR=10.0.2.15/24
GW=10.0.2.2
DNS=10.0.2.3
LOGLEVEL=warn
NET=
MTU=1500
NETBENCH=
NETVNET=
DATA=
NEWDISK=
MEMLOG=
THP=
CACHE=
SYSRA=
SHARE=
DAEMONCFG=
HOSTGW=
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	hyperbutler.ip=*) ADDR=${arg#hyperbutler.ip=} ;;
	hyperbutler.gw=*) GW=${arg#hyperbutler.gw=} ;;
	hyperbutler.dns=*) DNS=${arg#hyperbutler.dns=} ;;
	hyperbutler.loglevel=*) LOGLEVEL=${arg#hyperbutler.loglevel=} ;;
	hyperbutler.net=*) NET=${arg#hyperbutler.net=} ;;
	hyperbutler.mtu=*) MTU=${arg#hyperbutler.mtu=} ;;
	hyperbutler.netbench=1) NETBENCH="-bench-tcp 5201 -bench-vsock 5202" ;;
	hyperbutler.netvnet=1) NETVNET=-vnet ;;
	hyperbutler.data=*) DATA=${arg#hyperbutler.data=} ;;
	hyperbutler.newdisk=1) NEWDISK=1 ;;
	hyperbutler.memlog=1) MEMLOG=1 ;;
	hyperbutler.thp=*) THP=${arg#hyperbutler.thp=} ;;
	hyperbutler.cache=*) CACHE=${arg#hyperbutler.cache=} ;;
	hyperbutler.sysra=*) SYSRA=${arg#hyperbutler.sysra=} ;;
	hyperbutler.share=*) SHARE=${arg#hyperbutler.share=} ;;
	hyperbutler.daemoncfg=1) DAEMONCFG=1 ;;
	hyperbutler.hostgw=*) HOSTGW=${arg#hyperbutler.hostgw=} ;;
	esac
done
# Transparent huge pages only where a program asks (madvise), not for every anonymous
# mapping: linux-virt defaults to "always", which backs the Go heaps of dockerd and
# containerd with 2 MiB pages and keeps them resident at idle (REQ-MEM-001; see
# docs/research/idle-memory.md). hyperbutler.thp=always restores the kernel default.
case "${THP:-madvise}" in
always | madvise | never) echo "${THP:-madvise}" >/sys/kernel/mm/transparent_hugepage/enabled ;;
esac
if [ -n "$NET" ] && [ -d /sys/bus/vmbus ]; then
	modprobe tun
	# Restart netfwd if it dies. The TAP is persistent, so eth0 keeps its address.
	(while :; do
		# shellcheck disable=SC2086
		netfwd -port "$NET" -dev eth0 -mtu "$MTU" $NETVNET $NETBENCH >/dev/console 2>&1
		t "netfwd-exit $?"
		sleep 1
	done) &
	i=0
	while [ ! -e /sys/class/net/eth0 ] && [ $i -lt 250 ]; do
		sleep 0.02
		i=$((i + 1))
	done
	ip link set eth0 mtu "$MTU"
	# Containers on docker0 are routed, not NATed: the host stack sends replies for
	# them back to this guest address.
	echo 1 >/proc/sys/net/ipv4/ip_forward
	# Every frame netfwd writes to the TAP lands in the per-CPU input backlog; the
	# default of 1000 drops bursts from the host (one hvsock read carries hundreds of
	# frames) and turns host-to-guest TCP into retransmissions.
	echo 16384 >/proc/sys/net/core/netdev_max_backlog
fi
if ip link show eth0 >/dev/null 2>&1; then
	ip link set eth0 up
	ip addr add "$ADDR" dev eth0
	ip route add default via "$GW"
	echo "nameserver $DNS" >/etc/resolv.conf
fi
t net-done

# lun:N is the SCSI disk at LUN N of the (single) controller, whatever name the kernel
# gave it; a bare name (sda, vdb) is used as is. The same rule as in stage 1.
resolve_disk() {
	case "$1" in
	lun:*)
		lun=${1#lun:}
		case "$lun" in "" | *[!0-9]*) return 1 ;; esac
		for d in /sys/block/sd*; do
			[ -e "$d/device" ] || continue
			addr=$(basename "$(readlink "$d/device")")
			case "$addr" in
			*:0:0:"$lun") echo "/dev/${d##*/}"; return 0 ;;
			esac
		done
		return 1
		;;
	*[!a-z0-9]* | "") return 1 ;;
	*) [ -b "/dev/$1" ] && echo "/dev/$1" ;;
	esac
}

# The data disk (hyperbutler.data=lun:0, or a device name) holds /var/lib/docker: images,
# containers, volumes and their json-file logs. It is formatted only when it is blank
# (see data_disk), which is how a new VHDX reads; anything else that is not a clean ext4
# is refused, never reformatted. Without hyperbutler.data (the QEMU harness),
# /var/lib/docker is a tmpfs.
data_disk() {
	modprobe ext4
	i=0
	while ! dev=$(resolve_disk "$DATA") && [ $i -lt 500 ]; do
		sleep 0.01
		i=$((i + 1))
	done
	if [ -z "$dev" ] || [ ! -b "$dev" ]; then
		t "data-missing $DATA"
		return 1
	fi
	DATADEV=$dev
	# Blank means all three: the host says the VHDX was never written (hyperbutler.newdisk=1:
	# its allocation is still what it was at creation), a complete read of the first MiB
	# succeeded and is all zero, and blkid finds no file system. A failed or short read
	# is never taken for a blank disk.
	blank=
	if [ -n "$NEWDISK" ] && dd if="$dev" of=/tmp/data-head bs=65536 count=16 2>/dev/null &&
		[ "$(wc -c </tmp/data-head)" -eq 1048576 ] &&
		[ "$(tr -d '\000' </tmp/data-head | wc -c)" -eq 0 ] &&
		[ -z "$(blkid "$dev" 2>/dev/null)" ]; then
		blank=1
	fi
	rm -f /tmp/data-head
	if [ -n "$blank" ]; then
		t data-mkfs
		# -J size=128: journal blocks, once written, stay allocated in the VHDX (they
		# are never free, so never trimmed). The default for 64 GiB is several times
		# larger.
		if ! mke2fs -q -F -t ext4 -m 0 -L hyperbutler-data -J size=128 \
			-E nodiscard,lazy_itable_init=1,lazy_journal_init=1 "$dev" >/dev/console 2>&1; then
			t data-mkfs-failed
			return 1
		fi
	else
		# -p repairs what is safe to repair and fails (>= 4) on anything else.
		e2fsck -p "$dev" >/dev/console 2>&1
		rc=$?
		if [ $rc -ge 4 ]; then
			t "data-fsck-failed $rc"
			return 1
		fi
	fi
	# noinit_itable: the inode tables of a new VHDX already read as zeros, so the
	# background zeroing would only cost I/O.
	if ! mount -t ext4 -o noatime,noinit_itable "$dev" /var/lib/docker; then
		t data-mount-failed
		return 1
	fi
	t data-mounted
}
HYPERBUTLERD_ARGS=-no-trim
# Page cache: the binaries now run from the system disk, so they are file cache too (not
# Shmem). Keep 32 MiB and reclaim once 16 MiB more piles up at idle, instead of the
# default 64 MiB: what dockerd and containerd touch while idle refaults from the
# read-only disk (host file cache), cheaply. hyperbutler.cache=<threshold MiB> overrides it.
case "$CACHE" in
"" | *[!0-9]* | ????*) CACHE=16 ;;
esac
HYPERBUTLERD_CACHE="-cache-keep $((32 << 20)) -cache-threshold $((CACHE << 20))"
# hyperbutler.share=<host vsock port>: bind mounts from Windows paths (ADR 0007).
# hyperbutlerd mounts the host's share server at /mnt/hyperbutler (an empty directory of
# the read-only system disk) and keeps it mounted.
case "$SHARE" in
"" | *[!0-9]* | ??????????*) HYPERBUTLERD_SHARE= ;;
*) HYPERBUTLERD_SHARE="-share-port $SHARE -share-mount /mnt/hyperbutler" ;;
esac
if [ -n "$DATA" ]; then
	if ! data_disk; then
		echo "hyperbutler: the data disk could not be used; see the lines above" >/dev/console
		sleep 1
		poweroff -f
	fi
	HYPERBUTLERD_ARGS="-mount /var/lib/docker -dev $DATADEV -file /var/lib/docker/.hyperbutler-reserve"
else
	mount -t tmpfs -o mode=0710 docker /var/lib/docker
fi

# hyperbutlerd: the host control channel (vsock 2380), the free-space guard, automatic
# fstrim, page-cache reclaim (docs/research/guest-services.md) and the bind-mount relay. The guard fails
# closed until the host's first budget arrives, so dockerd waits for that (bounded).
# hyperbutlerd installs the host's daemon.json here and the init starts dockerd with it.
RUNDIR=/run/hyperbutler
# 0700: dockerd.env can hold proxy credentials (only root reads it).
mkdir -p -m 0700 "$RUNDIR"
DAEMON_JSON=$RUNDIR/daemon.json
# dockerd's environment (REQ-UX-009): the host's proxy settings and, in SSL_CERT_FILE, a
# CA bundle with the CA certificates imported from Windows. hyperbutlerd writes both
# before daemon.ready, so the first dockerd starts with them.
DOCKERD_ENV=$RUNDIR/dockerd.env
HYPERBUTLERD_DAEMON="-daemon-config $DAEMON_JSON -dockerd-env $DOCKERD_ENV -ca-bundle $RUNDIR/ca-certificates.crt"
if [ -d /sys/bus/vmbus ]; then
	rm -f /run/hyperbutlerd.ready
	(while :; do
		# shellcheck disable=SC2086
		hyperbutlerd $HYPERBUTLERD_ARGS $HYPERBUTLERD_CACHE $HYPERBUTLERD_SHARE $HYPERBUTLERD_DAEMON -ready /run/hyperbutlerd.ready >/dev/console 2>&1
		t "hyperbutlerd-exit $?"
		sleep 1
	done) &
	HYPERBUTLERD_LOOP=$!
	i=0
	while [ ! -e /run/hyperbutlerd.ready ] && [ $i -lt 1000 ]; do
		sleep 0.01
		i=$((i + 1))
	done
	t hyperbutlerd-ready
	# hyperbutler.daemoncfg=1: the host sends a daemon.json (or says there is none) right
	# after it connects; start dockerd with it, not without. Bounded (30 s): a host that
	# never sends one gets dockerd's defaults, and a file that arrives later is applied
	# with a dockerd restart.
	if [ -n "$DAEMONCFG" ]; then
		i=0
		while [ ! -e "$RUNDIR/daemon.ready" ] && [ $i -lt 1500 ]; do
			sleep 0.02
			i=$((i + 1))
		done
		if [ -e "$RUNDIR/daemon.ready" ]; then
			t daemon-config-ready
		else
			t daemon-config-timeout
		fi
	fi
fi

# The root is the erofs system disk, a real mount, so runc uses pivot_root(2): no
# DOCKER_RAMDISK (which the initramfs-only prototype needed).
#
# dockerd listens on its Unix socket only. On Hyper-V the guest agent relays AF_VSOCK
# port 2375 (hvsock from the host, which HCS restricts to the user who created the VM)
# to it, and accepts connections from the host CID only.
#
# QEMU for Windows has no vsock device, so there sockfwd relays TCP from QEMU hostfwd
# instead. QEMU harness only: that relay has no authentication, so anything that can
# reach eth0:2375 (including containers) gets root-equivalent access to dockerd.
if [ -d /sys/bus/vmbus ]; then
	# Restart the agent if it dies; without it dockerd is unreachable.
	(while :; do
		agent -port 2375 -unix /run/docker.sock >/dev/console 2>&1
		t "agent-exit $?"
		sleep 1
	done) &
	AGENT_LOOP=$!
else
	sockfwd -listen "${ADDR%/*}:2375" -unix /run/docker.sock >/dev/console 2>&1 &
fi
DOCKERD=
STOPPING=
RESTART=
STARTING=
GEN=0
# While STARTING, $DOCKERD may still name the previous (exited) dockerd: the handlers only
# set the flag, and start_dockerd acts on it once the new PID is known.
stop_dockerd() {
	t shutdown-requested
	STOPPING=1
	[ -z "$STARTING" ] && [ -n "$DOCKERD" ] && kill -TERM "$DOCKERD" 2>/dev/null
}
# SIGHUP (from hyperbutlerd): restart dockerd, for a new daemon.json.
restart_dockerd() {
	[ -n "$STOPPING" ] && return
	t dockerd-restart-requested
	RESTART=1
	[ -z "$STARTING" ] && [ -n "$DOCKERD" ] && kill -TERM "$DOCKERD" 2>/dev/null
}
trap stop_dockerd TERM USR2 INT
trap restart_dockerd HUP
# start_dockerd starts dockerd (with the installed daemon.json, if any) and records its
# generation and PID for hyperbutlerd.
start_dockerd() {
	STARTING=1
	set --
	[ -f "$DAEMON_JSON" ] && set -- "--config-file=$DAEMON_JSON"
	# host.docker.internal (REQ-NET-004): --add-host NAME:host-gateway maps to the host
	# stack's host gateway address, which forwards to the Windows host's loopback.
	[ -n "$HOSTGW" ] && set -- "$@" "--host-gateway-ip=$HOSTGW"
	# The environment goes to this dockerd only: a subshell exports the known names
	# from dockerd.env (never evaluated as shell code) and execs dockerd, so $! is
	# dockerd's PID. Traps are reset in the subshell.
	(
		if [ -f "$DOCKERD_ENV" ]; then
			while IFS= read -r kv; do
				case "$kv" in
				HTTP_PROXY=* | HTTPS_PROXY=* | NO_PROXY=* | SSL_CERT_FILE=*) export "$kv" ;;
				esac
			done <"$DOCKERD_ENV"
		fi
		exec dockerd --host=unix:///run/docker.sock --iptables=false --ip6tables=false \
			--shutdown-timeout=10 --log-level="$LOGLEVEL" "$@" >/dev/console 2>&1
	) &
	DOCKERD=$!
	GEN=$((GEN + 1))
	echo "$GEN $DOCKERD" >"$RUNDIR/dockerd.gen.new" && mv -f "$RUNDIR/dockerd.gen.new" "$RUNDIR/dockerd.gen"
	STARTING=
	if [ -n "$STOPPING" ] || [ -n "$RESTART" ]; then
		kill -TERM "$DOCKERD" 2>/dev/null
	fi
}

# Readahead on the system disk. At idle dockerd and containerd fault code in at random,
# and with the kernel's 128 KiB each fault pulls 128 KiB around it back into the page
# cache right after hyperbutlerd reclaimed it: about 70 MiB of churn (REQ-MEM-001,
# docs/research/idle-memory.md). A file's readahead is fixed when it is opened, so the
# small value must be set before dockerd starts. To keep the start fast, the binaries
# dockerd needs first are read once, sequentially, with the large value; hyperbutlerd's cache
# policy trims what stays unused. hyperbutler.sysra=<KiB> sets the small value.
case "$SYSRA" in
"" | *[!0-9]* | ?????*) SYSRA=16 ;;
esac
SYSDEV=$(awk '$2 == "/" { print $1 }' /proc/mounts)
SYSDEV=${SYSDEV#/dev/}
if [ -n "$SYSDEV" ] && [ -w "/sys/block/$SYSDEV/queue/read_ahead_kb" ]; then
	cat /usr/bin/dockerd /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/runc >/dev/null
	echo "$SYSRA" >"/sys/block/$SYSDEV/queue/read_ahead_kb"
	t system-readahead
fi
t dockerd-exec
start_dockerd

i=0
while [ ! -S /run/docker.sock ] && [ $i -lt 600 ]; do
	sleep 0.02
	i=$((i + 1))
done
t docker-sock

# hyperbutler.memlog=1: guest-side memory every 15 s, so host numbers can be split into
# guest use and VMM cost.
if [ -n "$MEMLOG" ]; then
	(
		while sleep 15; do
			m=$(grep -E '^(MemTotal|MemFree|MemAvailable|Cached|Shmem):' /proc/meminfo | tr -s ' ' | tr '\n' ' ')
			t "mem $m"
		done
	) &
fi

# A trapped signal interrupts wait; keep waiting until dockerd is really gone. Then
# restart it if hyperbutlerd asked for that; while hyperbutlerd holds dockerd.hold (it
# is applying a daemon.json), a dockerd that exited on its own waits for hyperbutlerd's
# next SIGHUP instead of powering the VM off. Otherwise dockerd's exit ends the VM.
while :; do
	while kill -0 "$DOCKERD" 2>/dev/null; do
		wait "$DOCKERD"
	done
	t dockerd-exit
	while [ -z "$STOPPING" ] && [ -z "$RESTART" ] && [ -e "$RUNDIR/dockerd.hold" ]; do
		sleep 0.1
	done
	if [ -n "$RESTART" ] && [ -z "$STOPPING" ]; then
		RESTART=
		rm -f /run/docker.sock
		t dockerd-restart
		start_dockerd
		continue
	fi
	break
done
for p in $HYPERBUTLERD_LOOP $AGENT_LOOP; do
	kill "$p" 2>/dev/null
done
killall hyperbutlerd agent 2>/dev/null
sync
if mountpoint -q /var/lib/docker; then
	umount /var/lib/docker 2>/dev/null || mount -o remount,ro /var/lib/docker
	t data-unmounted
fi
sync
poweroff -f
