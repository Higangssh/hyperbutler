#!/bin/sh
# winbox guest prototype init (PID 1). Throwaway: see docs/adr/0005-guest-image.md.
#
# Mounts the API file systems, loads the modules for whichever hypervisor it finds
# (Hyper-V vmbus or virtio), brings up the network, and starts dockerd, which starts
# its own containerd. Every step prints "winbox-t <uptime> <step>" on the console so
# the host can see where boot time goes.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

/bin/busybox --install -s

t() { read -r up _ </proc/uptime; echo "winbox-t $up $*"; }

mount -t proc -o nosuid,nodev,noexec proc /proc
t init-start
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts -o nosuid,noexec,gid=5,mode=0620,ptmxmode=0666 devpts /dev/pts
mount -t tmpfs -o nosuid,nodev,mode=1777 shm /dev/shm
mount -t tmpfs -o nosuid,nodev,mode=0755 run /run
mount -t tmpfs -o nosuid,nodev,mode=1777 tmp /tmp
mount -t cgroup2 -o nsdelegate cgroup2 /sys/fs/cgroup
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
hostname winbox
t mounts-done

# Hypervisor-specific drivers. hv_netvsc is built in; everything else is a module.
if [ -d /sys/bus/vmbus ]; then
	t hyperv
	modprobe -a hv_storvsc sd_mod hv_sock hv_balloon hv_utils
else
	t virtio
	modprobe -a virtio_rng virtio_net virtio_blk virtio_balloon vmw_vsock_virtio_transport
fi
modprobe -a overlay bridge br_netfilter veth
t modules-done

ip link set lo up
# The prototype only knows QEMU user networking (slirp). Override with winbox.ip=.
ADDR=10.0.2.15/24
GW=10.0.2.2
DNS=10.0.2.3
LOGLEVEL=warn
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	winbox.ip=*) ADDR=${arg#winbox.ip=} ;;
	winbox.gw=*) GW=${arg#winbox.gw=} ;;
	winbox.dns=*) DNS=${arg#winbox.dns=} ;;
	winbox.loglevel=*) LOGLEVEL=${arg#winbox.loglevel=} ;;
	esac
done
if ip link show eth0 >/dev/null 2>&1; then
	ip link set eth0 up
	ip addr add "$ADDR" dev eth0
	ip route add default via "$GW"
	echo "nameserver $DNS" >/etc/resolv.conf
fi
t net-done

mkdir -p /var/lib/docker
mount -t tmpfs -o mode=0710 docker /var/lib/docker

# The root file system is the initramfs itself, where pivot_root(2) is impossible.
# DOCKER_RAMDISK makes runc fall back to MS_MOVE + chroot. The production image must
# not need this (see ADR 0005).
export DOCKER_RAMDISK=true
# dockerd listens on its Unix socket only. On Hyper-V the guest agent relays AF_VSOCK
# port 2375 (hvsock from the host, which HCS restricts to the user who created the VM)
# to it, and accepts connections from the host CID only.
#
# QEMU for Windows has no vsock device, so there sockfwd relays TCP from QEMU hostfwd
# instead. QEMU harness only: that relay has no authentication, so anything that can
# reach eth0:2375 (including containers) gets root-equivalent access to dockerd.
if [ -d /sys/bus/vmbus ]; then
	# Restart the agent if it dies; without it dockerd is unreachable.
	(while :; do
		agent -port 2375 -unix /run/docker.sock >/dev/console 2>&1
		t "agent-exit $?"
		sleep 1
	done) &
else
	sockfwd -listen "${ADDR%/*}:2375" -unix /run/docker.sock >/dev/console 2>&1 &
fi
t dockerd-exec
dockerd --host=unix:///run/docker.sock --iptables=false --ip6tables=false \
	--log-level="$LOGLEVEL" >/dev/console 2>&1 &
DOCKERD=$!

i=0
while [ ! -S /run/docker.sock ] && [ $i -lt 600 ]; do
	sleep 0.02
	i=$((i + 1))
done
t docker-sock

# Guest-side memory every 15 s, so host numbers can be split into guest use and VMM cost.
(
	while sleep 15; do
		m=$(grep -E '^(MemTotal|MemFree|MemAvailable|Cached|Shmem):' /proc/meminfo | tr -s ' ' | tr '\n' ' ')
		t "mem $m"
	done
) &

wait $DOCKERD
t dockerd-exit $?
poweroff -f
