<?xml version="1.0" encoding="utf-8"?>
<!--
  The hyperbutler MSI (docs/install.md): a per-machine install of the release folder that
  dist/package.ps1 stages, built by dist/msi/build-msi.ps1 with WiX 5.

  Besides the files it does what the zip leaves to the user (ADR 0004, Installer and
  Installer (M4)):
    - installs and starts the HCS access broker service (hyperbutler-broker, LocalSystem,
      `hyperbutler setup broker install`), which starts the VM for every user signed in
      at the PC, so no one needs Hyper-V Administrators or elevation day to day;
    - puts the install folder and its clients\ folder at the end of the system PATH, so a
      docker CLI that is already installed keeps winning;
    - turns on Virtual Machine Platform if it is off, and asks for a restart;
    - only with ADDHYPERVADMIN=1 on the command line (developer mode, ADR 0004 option A),
      adds the installing user ([UserSID]) to Hyper-V Administrators; the window has no
      box for it any more;
    - a Start menu shortcut.
  The machine-wide steps run `hyperbutler setup` as SYSTEM. Group and DISM steps run on a
  first install or an upgrade only, never on a repair, which a standard user can start;
  the broker step runs on a repair too, and then only starts a stopped service or
  restores a missing one (it grants no one anything). An upgrade takes out of the group
  the accounts an earlier version of this installer put in, once the broker runs. The
  install folder is always Program Files\hyperbutler, which only administrators can
  write, because SYSTEM runs hyperbutler.exe and hyperbutler-broker.exe from it.
  Uninstalling removes the service, the files, the PATH entries and the shortcut, takes
  out of the group only the accounts this installer put in (an upgrade keeps them until
  the broker runs), and leaves Virtual Machine Platform on and every user's data in
  %LOCALAPPDATA%\hyperbutler alone (`hyperbutler uninstall` removes that).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- The -FailForTest MSI names itself so, in Apps too, and installs only with
       FAILTESTACK=1, so it is never mistaken for a release. -->
  <?if $(var.FailForTest) = 1 ?>
  <?define HbProductName = "hyperbutler FAILTEST" ?>
  <?else?>
  <?define HbProductName = "hyperbutler" ?>
  <?endif?>
  <Package Name="$(var.HbProductName)" Manufacturer="hyperbutler" Version="$(var.ProductVersion)"
           UpgradeCode="7280F4EA-D72B-40D2-A391-68035BD73997" Scope="perMachine" Language="1033"
           InstallerVersion="500">
    <SummaryInformation Description="hyperbutler $(var.Version): a Docker engine for Windows in a small Hyper-V VM, without WSL" />
    <!-- Same version too: a release replaces its own release candidate (build-msi.ps1).
         afterInstallInitialize: the old product is removed inside this install's
         transaction, so a failed upgrade rolls its removal back too, broker service
         included (its uninstall step has a rollback that installs it again). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of hyperbutler is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="hyperbutler.exe" SourceFile="!(bindpath.stage)hyperbutler.exe" />
    <Property Id="ARPPRODUCTICON" Value="hyperbutler.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Higangssh/hyperbutler" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Higangssh/hyperbutler#quick-start" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- The choices on the Setup options page; also settable on the command line.
         ADDHYPERVADMIN=1 (command line only, developer mode) adds the installing user to
         Hyper-V Administrators; the broker service makes it unnecessary, so it is off by
         default and the window has no box for it (ADR 0004, Installer (M4)). -->
    <Property Id="ADDHYPERVADMIN" Secure="yes" />
    <Property Id="ENABLEVMP" Value="1" Secure="yes" />
    <!-- UPDATECHECK: whether the app looks for a new release once a day (on by default;
         UPDATECHECK="" on the command line, or an unticked box, turns it off). Off is
         written as UpdateCheck=0 under HKLM\SOFTWARE\hyperbutler, which the app reads as its
         default (internal/engine/updatecheck_windows.go); an upgrade keeps a previous off. -->
    <Property Id="UPDATECHECK" Value="1" Secure="yes" />
    <Property Id="UPDATECHECKWAS" Secure="yes">
      <RegistrySearch Id="UpdateCheckWas" Root="HKLM" Key="SOFTWARE\hyperbutler" Name="UpdateCheck" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="UPDATECHECK" Action="HbUpdateCheckKeepOff" Value="[HBNOTHING]" Sequence="both" After="AppSearch" Condition="UPDATECHECKWAS=&quot;#0&quot;" />
    <SetDirectory Id="INSTALLFOLDER" Value="[ProgramFiles64Folder]hyperbutler\" Sequence="both" />
    <!-- The Host Compute Service exists once Virtual Machine Platform (or Hyper-V) is on and
         Windows has restarted. -->
    <Property Id="VMCOMPUTEPRESENT" Secure="yes">
      <RegistrySearch Id="VmcomputeService" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\vmcompute"
                      Name="ImagePath" Type="raw" Bitness="always64" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="hyperbutler">
        <Directory Id="ImageFolder" Name="image" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Product" Directory="INSTALLFOLDER">
      <Component Id="HyperbutlerExe">
        <!-- Name: without it WiX names the file after the whole Source text, bind path included. -->
        <File Id="HyperbutlerExe" Name="hyperbutler.exe" Source="!(bindpath.stage)hyperbutler.exe" KeyPath="yes">
          <Shortcut Id="HyperbutlerShortcut" Directory="ProgramMenuFolder" Name="hyperbutler" Advertise="no"
                    Description="A Docker engine for Windows, without WSL" WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>
      <!-- The HCS access broker, which `hyperbutler setup broker install` registers as the
           service. It opens the guest image in the image\ folder next to it, the same one
           hyperbutler.exe boots in developer mode, and checks it against the pin both
           executables carry (dist/package.ps1). -->
      <Component Id="BrokerExe">
        <File Id="BrokerExe" Name="hyperbutler-broker.exe" Source="!(bindpath.stage)hyperbutler-broker.exe" KeyPath="yes" />
      </Component>
      <Files Include="!(bindpath.stage)**">
        <Exclude Files="!(bindpath.stage)hyperbutler.exe" />
        <Exclude Files="!(bindpath.stage)hyperbutler-broker.exe" />
      </Files>
      <!-- The guest image: a VM's worker opens system.vhd as its own per-VM account, and a
           user cannot add that account to a file under Program Files (HcsGrantVmAccess needs
           WRITE_DAC). So the folder lets every VM (NT VIRTUAL MACHINE\Virtual Machines,
           S-1-5-83-0) read and nobody but administrators and SYSTEM write; the files the
           installer puts in it inherit that. -->
      <Component Id="ImageFolderAcl" Directory="ImageFolder" Guid="5C1E8A2D-3F47-4B90-A6D2-7E9B0C4F1A36">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;S-1-5-83-0)" />
        </CreateFolder>
      </Component>
      <Component Id="SystemPath" Guid="9E0D3C1B-6E4E-4B39-9C8B-1B7C3E9A4F20">
        <RegistryValue Root="HKLM" Key="SOFTWARE\hyperbutler" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <Environment Id="PathInstall" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" />
        <Environment Id="PathClients" Name="PATH" Value="[INSTALLFOLDER]clients" Part="last" Action="set" System="yes" />
      </Component>
      <Component Id="UpdateCheckOff" Guid="B7E2C9A4-1F3D-4E58-9A6B-2C8D0F4E7A19" Condition="NOT UPDATECHECK">
        <RegistryValue Root="HKLM" Key="SOFTWARE\hyperbutler" Name="UpdateCheck" Type="integer" Value="0" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Feature Id="Main" Title="hyperbutler" Level="1">
      <ComponentGroupRef Id="Product" />
    </Feature>

    <!-- Stop the user's engine before its files are replaced or removed, as that user
         (an immediate action impersonates). It may not be running; failures are ignored. -->
    <SetProperty Id="WixQuietExec64CmdLine" Value="&quot;[INSTALLFOLDER]hyperbutler.exe&quot; stop"
                 Before="HbStopEngine" Sequence="execute" />
    <CustomAction Id="HbStopEngine" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64" Execute="immediate" Return="ignore" />

    <!-- The HCS access broker service (ADR 0004, Installer (M4)), as SYSTEM. install is
         idempotent: it leaves a running service of this executable alone (a repair must
         not end every user's VM), starts a stopped one, and registers again one of another
         executable or one an upgrade's removal deleted. It runs after InstallFiles, its
         rollback (uninstall) before them on the way back; the uninstall runs before
         RemoveFiles, so the service is stopped and gone before its files are, and its
         rollback (install) runs after RemoveFiles' rollback restored them. On a first
         install a failure fails the install, which rolls back: without the service the
         product does not work as the installer says (HbBrokerInstallFirst, Return
         check). On an upgrade or a repair it does not stop the install (HbBrokerInstall):
         setup records it (LastResult), and doctor and start explain it. -->
    <SetProperty Id="HbBrokerInstallFirst" Before="HbBrokerInstallFirst" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup broker install" />
    <CustomAction Id="HbBrokerInstallFirst" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="HbBrokerInstall" Before="HbBrokerInstall" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup broker install" />
    <CustomAction Id="HbBrokerInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="HbBrokerInstallRollback" Before="HbBrokerInstallRollback" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup broker uninstall" />
    <CustomAction Id="HbBrokerInstallRollback" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <SetProperty Id="HbBrokerUninstall" Before="HbBrokerUninstall" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup broker uninstall" />
    <CustomAction Id="HbBrokerUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="HbBrokerUninstallRollback" Before="HbBrokerUninstallRollback" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup broker install" />
    <CustomAction Id="HbBrokerUninstallRollback" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- An upgrade takes out of Hyper-V Administrators the accounts an earlier version of
         this installer put in (ADR 0004, Installer), but only once the broker runs
         (setup if-broker), and not when this install adds the user again (ADDHYPERVADMIN=1).
         It has no rollback, so it runs last. -->
    <SetProperty Id="HbDropHyperVAdmins" Before="HbDropHyperVAdmins" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup hyperv-admins remove --all --if-broker" />
    <CustomAction Id="HbDropHyperVAdmins" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Hyper-V Administrators: as SYSTEM, for the user the install runs for (UserSID, which
         Windows Installer sets), with ADDHYPERVADMIN=1 only. A failure does not stop the
         install; setup records it under HKLM\SOFTWARE\hyperbutler\Setup (LastResult) and
         doctor shows the membership. -->
    <SetProperty Id="HbAddHyperVAdmin" Before="HbAddHyperVAdmin" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup hyperv-admins add --sid &quot;[UserSID]&quot;" />
    <CustomAction Id="HbAddHyperVAdmin" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="HbAddHyperVAdminRollback" Before="HbAddHyperVAdminRollback" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup hyperv-admins remove --sid &quot;[UserSID]&quot;" />
    <CustomAction Id="HbAddHyperVAdminRollback" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <SetProperty Id="HbRemoveHyperVAdmin" Before="HbRemoveHyperVAdmin" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup hyperv-admins remove --all" />
    <CustomAction Id="HbRemoveHyperVAdmin" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Virtual Machine Platform: as SYSTEM, only when the Host Compute Service is missing. -->
    <SetProperty Id="HbEnableVMP" Before="HbEnableVMP" Sequence="execute"
                 Value="&quot;[#HyperbutlerExe]&quot; setup vm-platform" />
    <CustomAction Id="HbEnableVMP" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="HbStopEngine" Before="InstallValidate" Condition="REMOVE~=&quot;ALL&quot; OR WIX_UPGRADE_DETECTED" />
      <!-- Uninstall, and the removal of the old product in an upgrade. -->
      <Custom Action="HbBrokerUninstallRollback" Before="HbBrokerUninstall" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="HbBrokerUninstall" Before="HbRemoveHyperVAdmin" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="HbRemoveHyperVAdmin" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- First install, upgrade and repair. The rollback only where this install made
           the service: a failed repair keeps the one it found. -->
      <Custom Action="HbBrokerInstallRollback" After="InstallFiles" Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="HbBrokerInstallFirst" After="HbBrokerInstallRollback" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="HbBrokerInstall" After="HbBrokerInstallFirst" Condition="NOT REMOVE~=&quot;ALL&quot; AND (Installed OR WIX_UPGRADE_DETECTED)" />
      <!-- Takes out only this install's account, and only if this install recorded it. -->
      <Custom Action="HbAddHyperVAdminRollback" After="HbBrokerInstall" Condition="NOT Installed AND ADDHYPERVADMIN=&quot;1&quot;" />
      <Custom Action="HbAddHyperVAdmin" After="HbAddHyperVAdminRollback" Condition="NOT Installed AND ADDHYPERVADMIN=&quot;1&quot;" />
      <Custom Action="HbEnableVMP" After="HbAddHyperVAdmin" Condition="NOT Installed AND ENABLEVMP=&quot;1&quot; AND NOT VMCOMPUTEPRESENT" />
      <!-- NOT Installed: WIX_UPGRADE_DETECTED is a public property a standard user could
           pass to a repair (which runs as SYSTEM); only a real upgrade, an install of
           this product while it is not installed yet, which needs an administrator, may
           take accounts out of the group. -->
      <Custom Action="HbDropHyperVAdmins" Before="InstallFinalize" Condition="NOT Installed AND WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot; AND NOT ADDHYPERVADMIN=&quot;1&quot;" />
      <ScheduleReboot After="InstallFinalize" Condition="NOT Installed AND ENABLEVMP=&quot;1&quot; AND NOT VMCOMPUTEPRESENT" />
    </InstallExecuteSequence>
    <?if $(var.FailForTest) = 1 ?>
    <!-- build-msi.ps1 -FailForTest only (never a release): WIXFAILWHENDEFERRED=1 fails the
         install just before InstallFinalize, to test the rollbacks (docs/install.md). -->
    <util:FailWhenDeferred />
    <Launch Condition="FAILTESTACK=&quot;1&quot; OR Installed"
            Message="This is a test build of hyperbutler that fails on purpose (build-msi.ps1 -FailForTest), not a release. Install it only for the rollback test, with FAILTESTACK=1." />
    <?endif?>

    <UI Id="HbUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <Dialog Id="HbOptionsDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Setup options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="What hyperbutler needs from Windows, done once now." />
        <Control Id="VmpBox" Type="CheckBox" X="20" Y="50" Width="330" Height="15" Property="ENABLEVMP" CheckBoxValue="1"
                 Text="Turn on Virtual Machine Platform if it is off (Windows asks for a restart)" />
        <Control Id="BrokerTitle" Type="Text" X="20" Y="70" Width="330" Height="12" NoPrefix="yes"
                 Text="The hyperbutler broker service is installed and started" />
        <Control Id="BrokerText" Type="Text" X="36" Y="84" Width="314" Height="56" NoPrefix="yes"
                 Text="A small Windows service that starts and stops the hyperbutler VM for the people signed in at this PC, so hyperbutler needs no administrator rights and no Hyper-V Administrators membership day to day. It takes only hyperbutler's own requests, over a local pipe, and each person reaches only their own VM. Uninstalling hyperbutler removes it." />
        <Control Id="UpdateBox" Type="CheckBox" X="20" Y="144" Width="330" Height="15" Property="UPDATECHECK" CheckBoxValue="1"
                 Text="Check GitHub for a new hyperbutler version once a day" />
        <Control Id="UpdateText" Type="Text" X="36" Y="160" Width="314" Height="40" NoPrefix="yes"
                 Text="Privacy: an anonymous request for the latest release to api.github.com, nothing else; hyperbutler sends no usage data. Change it later with: hyperbutler config set updateCheck false" />
        <Control Id="PathText" Type="Text" X="20" Y="202" Width="330" Height="28" NoPrefix="yes"
                 Text="The hyperbutler folder and its docker CLI (clients) are added to the end of the system PATH, so a docker CLI you already have keeps being used." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="HbOptionsDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="HbOptionsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="HbOptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HbOptionsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
                Value="If Setup asks you to, restart Windows first. Then open hyperbutler from the Start menu, or run hyperbutler start in a new terminal: no administrator rights needed." />
    </UI>
    <UIRef Id="WixUI_Common" />
    <!-- Drawn by build-msi.ps1 from assets/brand. -->
    <WixVariable Id="WixUIDialogBmp" Value="!(bindpath.ui)dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="!(bindpath.ui)banner.bmp" />
  </Package>
</Wix>
